# Copy to .env and fill in values — never commit .env
DB_PASSWORD=your_strong_password_here
DATABASE_URL=postgresql://gsr_user:your_strong_password_here@db:5432/gsr_db

# JWT — change to a random 32+ character string in production
JWT_SECRET_KEY=change-me-to-random-32-chars-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Firebase (Sprint 3 — Owner/Customer OTP)
# Download service account JSON from Firebase Console → Project Settings → Service Accounts
# FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json
