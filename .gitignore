# Terraform — never commit state or real variable values
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
!terraform.tfvars.example
crash.log
.terraform.lock.hcl

# AWS keys
*.pem
*.ppk

# Python / FastAPI
__pycache__/
*.pyc
*.pyo
.env
.env.*
venv/
.venv/

# Flutter / Android
app/.dart_tool/
app/build/
*.jks
*.keystore
google-services.json
GoogleService-Info.plist

# IDE
.vscode/
.idea/
*.iml

# Corporate CA bundle (machine-specific, not for version control)
corporate-ca-bundle.pem

# OS
.DS_Store
Thumbs.db
